// Supabase connection. Real values live in Secrets.xcconfig (git-ignored);
// copy Secrets.example.xcconfig to Secrets.xcconfig and fill it in.
// SUPABASE_HOST is the bare host: xcconfig treats "//" as a comment, so no https://.
SUPABASE_HOST =
SUPABASE_ANON_KEY =

// Signing defaults; Secrets.xcconfig overrides them per Mac.
PRODUCT_BUNDLE_IDENTIFIER = com.elmaedesistemas.lumoria
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Secrets.xcconfig"
